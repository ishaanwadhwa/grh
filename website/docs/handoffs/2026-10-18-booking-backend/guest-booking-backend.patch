diff --git b/website/src/lib/msg91.ts b/website/src/lib/msg91.ts
new file mode 100644
index 0000000..833cc39
--- /dev/null
+++ b/website/src/lib/msg91.ts
@@ -0,0 +1,66 @@
+// MSG91 senders. Each resolves true only when MSG91 accepted the message; false when not configured,
+// on any error, or after the timeout, so callers never fail a booking because a message failed.
+const WHATSAPP_URL = "https://api.msg91.com/api/v5/whatsapp/whatsapp-outbound-message/bulk/";
+const SMS_FLOW_URL = "https://control.msg91.com/api/v5/flow";
+const TIMEOUT_MS = 4000;
+
+/**
+ * Approved WhatsApp template. bodyValues fill {{1}}, {{2}}… in order; `button` fills an
+ * authentication template's copy-code button (Meta requires the code in both places).
+ */
+export async function sendWhatsAppTemplate(
+  to: string,
+  template: string | undefined,
+  bodyValues: string[],
+  button?: string,
+): Promise<boolean> {
+  const key = process.env.MSG91_AUTH_KEY;
+  const from = process.env.NEXT_PUBLIC_WHATSAPP_NUMBER;
+  const namespace = process.env.MSG91_WA_NAMESPACE;
+  if (!key || !from || !namespace || !template) return false;
+
+  const components: Record<string, { type: "text"; value: string; subtype?: "url" }> = {};
+  bodyValues.forEach((value, i) => (components[`body_${i + 1}`] = { type: "text", value }));
+  if (button) components.button_1 = { subtype: "url", type: "text", value: button };
+
+  return post(WHATSAPP_URL, key, {
+    integrated_number: from,
+    content_type: "template",
+    payload: {
+      messaging_product: "whatsapp",
+      type: "template",
+      template: {
+        name: template,
+        language: { code: process.env.MSG91_WA_LANGUAGE || "en", policy: "deterministic" },
+        namespace,
+        to_and_components: [{ to: [to], components }],
+      },
+    },
+  });
+}
+
+/** DLT-approved SMS flow. `vars` keys must match the flow's ##variables##. India only. */
+export async function sendSmsFlow(to: string, flowId: string | undefined, vars: Record<string, string>): Promise<boolean> {
+  const key = process.env.MSG91_AUTH_KEY;
+  if (!key || !flowId) return false;
+  return post(SMS_FLOW_URL, key, { template_id: flowId, short_url: "0", recipients: [{ mobiles: to, ...vars }] });
+}
+
+async function post(url: string, key: string, body: unknown): Promise<boolean> {
+  try {
+    const res = await fetch(url, {
+      method: "POST",
+      headers: { authkey: key, "content-type": "application/json", accept: "application/json" },
+      body: JSON.stringify(body),
+      signal: AbortSignal.timeout(TIMEOUT_MS),
+    });
+    const data = await res.json().catch(() => ({}));
+    // MSG91 can answer HTTP 200 with an error body.
+    const ok = res.ok && data?.type !== "error" && data?.status !== "fail" && data?.hasError !== true;
+    if (!ok) console.error("MSG91 send failed:", res.status, data?.message ?? data?.errors ?? "");
+    return ok;
+  } catch (error) {
+    console.error("MSG91 send failed:", error instanceof Error ? error.name : error);
+    return false;
+  }
+}
diff --git b/website/src/lib/otp.test.ts b/website/src/lib/otp.test.ts
new file mode 100644
index 0000000..af8eb71
--- /dev/null
+++ b/website/src/lib/otp.test.ts
@@ -0,0 +1,114 @@
+// Run from website/:
+//   npx tsc --module commonjs --target es2022 --types node --esModuleInterop --skipLibCheck --outDir /tmp/otp-test src/lib/otp.ts src/lib/msg91.ts src/lib/otp.test.ts && node --test /tmp/otp-test/
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import {
+  OTP, normalizePhone, newCode, hashCode, sendDecision, verifyDecision,
+  signToken, readToken, bookingCheck, confirmationChannel,
+} from "./otp";
+import { sendWhatsAppTemplate, sendSmsFlow } from "./msg91";
+
+const SECRET = "test-secret";
+const NOW = 1_800_000_000_000;
+const sec = (n: number) => n * 1000;
+
+test("phone numbers", () => {
+  assert.equal(normalizePhone("+91", "98765 43210"), "919876543210");
+  assert.equal(normalizePhone("+91", "58765 43210"), null); // Indian mobiles start 6–9
+  assert.equal(normalizePhone("+91", "987654321"), null);
+  assert.equal(normalizePhone("+44", "7911-123456"), "447911123456");
+  assert.equal(normalizePhone("44", "7911123456"), null);
+  assert.equal(normalizePhone("+44", "12345"), null);
+});
+
+test("codes and hashes", () => {
+  for (let i = 0; i < 50; i++) assert.match(newCode(), /^\d{6}$/);
+  assert.equal(hashCode("91x", "123456", SECRET), hashCode("91x", "123456", SECRET));
+  assert.notEqual(hashCode("91x", "123456", SECRET), hashCode("91x", "123456", "other"));
+});
+
+test("send limits", () => {
+  assert.deepEqual(sendDecision([], [], NOW), { ok: true });
+  assert.deepEqual(sendDecision([NOW - sec(10)], [], NOW), { ok: false, code: "OTP_COOLDOWN", retryAfter: 20 });
+  const three = [NOW - sec(800), NOW - sec(400), NOW - sec(60)];
+  assert.deepEqual(sendDecision(three, [], NOW), { ok: false, code: "OTP_SEND_LIMIT", retryAfter: 100 });
+  assert.deepEqual(sendDecision([NOW - sec(901), ...three.slice(1)], [], NOW), { ok: true });
+  const ten = Array.from({ length: 10 }, (_, i) => NOW - sec(3000 - i * 60));
+  assert.deepEqual(sendDecision([], ten, NOW), { ok: false, code: "OTP_SEND_LIMIT", retryAfter: 600 });
+});
+
+test("code checks", () => {
+  const right = hashCode("91x", "123456", SECRET);
+  const wrong = hashCode("91x", "000000", SECRET);
+  const row = { codeHash: right, createdAt: NOW - sec(60), attempts: 0, consumed: false };
+  assert.deepEqual(verifyDecision(row, right, NOW), { ok: true });
+  assert.deepEqual(verifyDecision(row, wrong, NOW), { ok: false, code: "OTP_WRONG", attemptsLeft: 4, wrongGuess: true });
+  assert.deepEqual(verifyDecision({ ...row, attempts: 4 }, wrong, NOW), { ok: false, code: "OTP_TOO_MANY_ATTEMPTS", wrongGuess: true });
+  assert.deepEqual(verifyDecision({ ...row, attempts: 5 }, right, NOW), { ok: false, code: "OTP_TOO_MANY_ATTEMPTS", wrongGuess: false });
+  assert.deepEqual(verifyDecision({ ...row, createdAt: NOW - sec(OTP.codeTtlSec + 1) }, right, NOW), { ok: false, code: "OTP_EXPIRED", wrongGuess: false });
+  assert.deepEqual(verifyDecision({ ...row, consumed: true }, right, NOW), { ok: false, code: "OTP_EXPIRED", wrongGuess: false });
+  assert.deepEqual(verifyDecision(null, right, NOW), { ok: false, code: "OTP_EXPIRED", wrongGuess: false });
+});
+
+test("tokens", () => {
+  const token = signToken("919876543210", "sms", NOW, SECRET);
+  assert.deepEqual(readToken(token, "919876543210", NOW + sec(60), SECRET), { channel: "sms" });
+  assert.equal(readToken(token, "919999999999", NOW, SECRET), null); // other phone
+  assert.equal(readToken(token, "919876543210", NOW + sec(OTP.tokenTtlSec + 1), SECRET), null); // expired
+  assert.equal(readToken(token, "919876543210", NOW, "other"), null); // other secret
+  assert.equal(readToken(token.replace(".sms.", ".whatsapp."), "919876543210", NOW, SECRET), null); // tampered
+  assert.equal(readToken("garbage", "919876543210", NOW, SECRET), null);
+});
+
+test("which bookings need a code", () => {
+  assert.deepEqual(bookingCheck(false, "+91", false, null), { ok: true, phoneVerified: null, verifiedVia: null });
+  assert.deepEqual(bookingCheck(true, "+91", true, { channel: "whatsapp" }), { ok: true, phoneVerified: true, verifiedVia: "whatsapp" });
+  assert.deepEqual(bookingCheck(true, "+91", true, null), { ok: false }); // bad or expired token
+  assert.deepEqual(bookingCheck(true, "+91", false, null), { ok: false });
+  assert.deepEqual(bookingCheck(true, "+44", false, null), { ok: true, phoneVerified: false, verifiedVia: null });
+});
+
+test("confirmation channel", () => {
+  assert.equal(confirmationChannel("+91", true, "whatsapp"), "whatsapp");
+  assert.equal(confirmationChannel("+91", true, "sms"), "sms");
+  assert.equal(confirmationChannel("+91", false, null), "sms");
+  assert.equal(confirmationChannel("+44", false, null), null);
+  assert.equal(confirmationChannel("+44", true, null), "whatsapp");
+});
+
+test("MSG91 senders against a fake MSG91", async () => {
+  const calls: { url: string; init: RequestInit }[] = [];
+  let reply: () => Promise<Response> = async () => Response.json({ status: "success", hasError: false });
+  globalThis.fetch = (async (url: string, init: RequestInit) => {
+    calls.push({ url, init });
+    return reply();
+  }) as typeof fetch;
+
+  delete process.env.MSG91_AUTH_KEY;
+  assert.equal(await sendWhatsAppTemplate("919876543210", "otp", ["123456"], "123456"), false);
+  assert.equal(calls.length, 0, "not configured: no request");
+
+  Object.assign(process.env, { MSG91_AUTH_KEY: "k", NEXT_PUBLIC_WHATSAPP_NUMBER: "919800000000", MSG91_WA_NAMESPACE: "ns" });
+  assert.equal(await sendWhatsAppTemplate("919876543210", "otp", ["123456"], "123456"), true);
+  const sent = JSON.parse(String(calls[0].init.body));
+  assert.equal(calls[0].url, "https://api.msg91.com/api/v5/whatsapp/whatsapp-outbound-message/bulk/");
+  assert.equal((calls[0].init.headers as Record<string, string>).authkey, "k");
+  assert.equal(sent.integrated_number, "919800000000");
+  assert.deepEqual(sent.payload.template.to_and_components, [{
+    to: ["919876543210"],
+    components: { body_1: { type: "text", value: "123456" }, button_1: { subtype: "url", type: "text", value: "123456" } },
+  }]);
+
+  reply = async () => Response.json({ type: "error", message: "Invalid template" }); // 200 with an error body
+  assert.equal(await sendWhatsAppTemplate("919876543210", "otp", ["123456"]), false);
+
+  reply = async () => { throw Object.assign(new Error("timed out"), { name: "TimeoutError" }); };
+  assert.equal(await sendSmsFlow("919876543210", "flow1", { otp: "123456" }), false);
+
+  reply = async () => Response.json({ type: "success", message: "3763646c" });
+  assert.equal(await sendSmsFlow("919876543210", "flow1", { otp: "123456" }), true);
+  assert.deepEqual(JSON.parse(String(calls.at(-1)!.init.body)), {
+    template_id: "flow1", short_url: "0", recipients: [{ mobiles: "919876543210", otp: "123456" }],
+  });
+  assert.equal(await sendSmsFlow("919876543210", undefined, { otp: "1" }), false); // flow not configured
+});
diff --git b/website/src/lib/otp.ts b/website/src/lib/otp.ts
new file mode 100644
index 0000000..c4f3f50
--- /dev/null
+++ b/website/src/lib/otp.ts
@@ -0,0 +1,112 @@
+import { createHmac, randomInt, timingSafeEqual } from "node:crypto";
+
+// Booking OTP rules. Pure functions only (no DB, no network) so they can be checked in otp.test.ts.
+export const OTP = {
+  length: 6,
+  codeTtlSec: 600,
+  cooldownSec: 30,
+  maxPerPhone: 3,
+  phoneWindowSec: 900,
+  maxPerIp: 10,
+  ipWindowSec: 3600,
+  maxAttempts: 5,
+  tokenTtlSec: 900,
+} as const;
+
+export type Channel = "whatsapp" | "sms";
+
+export const otpEnabled = () => process.env.NEXT_PUBLIC_RESERVATION_OTP === "on";
+
+/** "+91", "98765 43210" → "919876543210" (country code + number, digits only), or null if invalid. */
+export function normalizePhone(phoneCode: string, phone: string): string | null {
+  if (!/^\+\d{1,4}$/.test(phoneCode)) return null;
+  const digits = phone.replace(/[\s-]/g, "");
+  const valid = phoneCode === "+91" ? /^[6-9]\d{9}$/.test(digits) : /^\d{6,14}$/.test(digits);
+  return valid ? phoneCode.slice(1) + digits : null;
+}
+
+export const newCode = () => randomInt(0, 10 ** OTP.length).toString().padStart(OTP.length, "0");
+
+// Keyed hash: a 6-digit code behind a plain hash could be brute-forced from a leaked row.
+export const hashCode = (phone: string, code: string, secret: string) =>
+  createHmac("sha256", secret).update(`${phone}:${code}`).digest("hex");
+
+function safeEqual(a: string, b: string) {
+  const x = Buffer.from(a);
+  const y = Buffer.from(b);
+  return x.length === y.length && timingSafeEqual(x, y);
+}
+
+export type SendDecision = { ok: true } | { ok: false; code: "OTP_COOLDOWN" | "OTP_SEND_LIMIT"; retryAfter: number };
+
+/** phoneSends / ipSends: times (ms) of earlier sends for this phone / this IP. */
+export function sendDecision(phoneSends: number[], ipSends: number[], now: number): SendDecision {
+  const last = Math.max(0, ...phoneSends);
+  if (now - last < OTP.cooldownSec * 1000) {
+    return { ok: false, code: "OTP_COOLDOWN", retryAfter: Math.ceil((last + OTP.cooldownSec * 1000 - now) / 1000) };
+  }
+  for (const [sends, max, windowSec] of [
+    [phoneSends, OTP.maxPerPhone, OTP.phoneWindowSec],
+    [ipSends, OTP.maxPerIp, OTP.ipWindowSec],
+  ] as const) {
+    const recent = sends.filter((t) => now - t < windowSec * 1000).sort((a, b) => a - b);
+    if (recent.length >= max) {
+      // Allowed again once enough of the oldest sends leave the window.
+      const freedAt = recent[recent.length - max] + windowSec * 1000;
+      return { ok: false, code: "OTP_SEND_LIMIT", retryAfter: Math.ceil((freedAt - now) / 1000) };
+    }
+  }
+  return { ok: true };
+}
+
+export type CodeRow = { codeHash: string; createdAt: number; attempts: number; consumed: boolean };
+export type VerifyDecision =
+  | { ok: true }
+  | { ok: false; code: "OTP_EXPIRED" | "OTP_TOO_MANY_ATTEMPTS"; wrongGuess: boolean }
+  | { ok: false; code: "OTP_WRONG"; attemptsLeft: number; wrongGuess: true };
+
+/** row: the latest code sent to this phone. wrongGuess tells the caller to count an attempt. */
+export function verifyDecision(row: CodeRow | null, codeHash: string, now: number): VerifyDecision {
+  if (!row || row.consumed || now - row.createdAt > OTP.codeTtlSec * 1000) {
+    return { ok: false, code: "OTP_EXPIRED", wrongGuess: false };
+  }
+  if (row.attempts >= OTP.maxAttempts) return { ok: false, code: "OTP_TOO_MANY_ATTEMPTS", wrongGuess: false };
+  if (safeEqual(row.codeHash, codeHash)) return { ok: true };
+  const attemptsLeft = OTP.maxAttempts - row.attempts - 1;
+  return attemptsLeft > 0
+    ? { ok: false, code: "OTP_WRONG", attemptsLeft, wrongGuess: true }
+    : { ok: false, code: "OTP_TOO_MANY_ATTEMPTS", wrongGuess: true };
+}
+
+/** 15-minute proof that `phone` passed OTP over `channel`: "<phone>.<channel>.<expiry>.<signature>". */
+export function signToken(phone: string, channel: Channel, now: number, secret: string): string {
+  const body = `${phone}.${channel}.${Math.floor(now / 1000) + OTP.tokenTtlSec}`;
+  return `${body}.${createHmac("sha256", secret).update(body).digest("base64url")}`;
+}
+
+export function readToken(token: string, phone: string, now: number, secret: string): { channel: Channel } | null {
+  const parts = token.split(".");
+  if (parts.length !== 4) return null;
+  const [tokenPhone, channel, expiry, signature] = parts;
+  const expected = createHmac("sha256", secret).update(`${tokenPhone}.${channel}.${expiry}`).digest("base64url");
+  if (!safeEqual(signature, expected) || tokenPhone !== phone || Number(expiry) * 1000 < now) return null;
+  return channel === "whatsapp" || channel === "sms" ? { channel } : null;
+}
+
+export type BookingCheck = { ok: true; phoneVerified: boolean | null; verifiedVia: Channel | null } | { ok: false };
+
+/**
+ * Switch off: not checked (null). Switch on: a valid token verifies; a bad token is refused;
+ * no token is refused for +91 and accepted as unverified for other country codes (staff confirm).
+ */
+export function bookingCheck(enabled: boolean, phoneCode: string, tokenGiven: boolean, token: { channel: Channel } | null): BookingCheck {
+  if (!enabled) return { ok: true, phoneVerified: null, verifiedVia: null };
+  if (tokenGiven) return token ? { ok: true, phoneVerified: true, verifiedVia: token.channel } : { ok: false };
+  return phoneCode === "+91" ? { ok: false } : { ok: true, phoneVerified: false, verifiedVia: null };
+}
+
+/** SMS when the guest verified by SMS or isn't on WhatsApp (India only); otherwise WhatsApp. */
+export function confirmationChannel(phoneCode: string, isWhatsApp: boolean, verifiedVia: Channel | null): Channel | null {
+  if (verifiedVia === "sms" || !isWhatsApp) return phoneCode === "+91" ? "sms" : null;
+  return "whatsapp";
+}
