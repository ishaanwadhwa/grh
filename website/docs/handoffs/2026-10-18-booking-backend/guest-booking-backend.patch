diff --git b/website/src/app/api/otp/send/route.ts b/website/src/app/api/otp/send/route.ts
new file mode 100644
index 0000000..bf6d3c5
--- /dev/null
+++ b/website/src/app/api/otp/send/route.ts
@@ -0,0 +1,65 @@
+import { createClient } from "@supabase/supabase-js";
+import { after } from "next/server";
+import { OTP, otpEnabled, normalizePhone, newCode, hashCode, sendDecision, type Channel } from "@/lib/otp";
+import { sendWhatsAppTemplate, sendSmsFlow } from "@/lib/msg91";
+
+const fail = (status: number, code: string, error: string, extra: Record<string, unknown> = {}) =>
+  Response.json({ error, code, ...extra }, { status });
+
+export async function POST(request: Request) {
+  if (!otpEnabled()) return fail(404, "OTP_DISABLED", "Phone verification is turned off.");
+
+  const body = await request.json().catch(() => null);
+  const phoneCode = typeof body?.phoneCode === "string" ? body.phoneCode : "+91";
+  const phone = normalizePhone(phoneCode, typeof body?.phone === "string" ? body.phone : "");
+  const channel: Channel = body?.channel === "sms" ? "sms" : "whatsapp";
+  if (!phone) return fail(400, "INVALID_PHONE", "Please enter a valid mobile number.");
+  if (channel === "sms" && phoneCode !== "+91") return fail(400, "SMS_UNAVAILABLE", "SMS codes are only available for Indian numbers.");
+
+  const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
+  const key = process.env.SUPABASE_SERVICE_ROLE_KEY;
+  const secret = process.env.OTP_TOKEN_SECRET;
+  if (!url || !key || !secret) return fail(503, "SERVER_ERROR", "Phone verification is not configured.");
+  const supabase = createClient(url, key);
+
+  const ip = request.headers.get("x-forwarded-for")?.split(",")[0]?.trim() ?? "";
+  const now = Date.now();
+  const since = new Date(now - OTP.ipWindowSec * 1000).toISOString(); // the longest window
+  const [byPhone, byIp] = await Promise.all([
+    supabase.from("phone_verifications").select("created_at").eq("phone", phone).gte("created_at", since),
+    supabase.from("phone_verifications").select("created_at").eq("ip", ip).gte("created_at", since),
+  ]);
+  if (byPhone.error || byIp.error) return fail(500, "SERVER_ERROR", "Could not send a code. Please try again.");
+
+  const times = (rows: { created_at: string }[]) => rows.map((row) => Date.parse(row.created_at));
+  // Requests without an IP header share the '' bucket, so they still face the IP limit.
+  const decision = sendDecision(times(byPhone.data), times(byIp.data), now);
+  if (!decision.ok) {
+    const error = decision.code === "OTP_COOLDOWN"
+      ? "Please wait a moment before asking for another code."
+      : "Too many codes requested. Please try again later.";
+    return fail(429, decision.code, error, { retryAfter: decision.retryAfter });
+  }
+
+  const code = newCode();
+  const { data: row, error } = await supabase
+    .from("phone_verifications")
+    .insert({ phone, ip, channel, code_hash: hashCode(phone, code, secret) })
+    .select("id")
+    .single();
+  if (error || !row) return fail(500, "SERVER_ERROR", "Could not send a code. Please try again.");
+
+  const sent = channel === "whatsapp"
+    ? await sendWhatsAppTemplate(phone, process.env.MSG91_WA_OTP_TEMPLATE, [code], code)
+    : await sendSmsFlow(phone, process.env.MSG91_SMS_OTP_FLOW_ID, { otp: code });
+  if (!sent) {
+    await supabase.from("phone_verifications").delete().eq("id", row.id); // a failed send shouldn't use up the guest's limit
+    return fail(502, "OTP_SEND_FAILED", "We couldn't send the code. Please try again.");
+  }
+
+  // ponytail: purge on send; move to a Vercel cron if this table ever gets busy.
+  after(async () => {
+    await supabase.from("phone_verifications").delete().lt("created_at", new Date(now - 86_400_000).toISOString());
+  });
+  return Response.json({ sent: true, channel, resendIn: OTP.cooldownSec, expiresIn: OTP.codeTtlSec });
+}
diff --git b/website/src/app/api/otp/verify/route.ts b/website/src/app/api/otp/verify/route.ts
new file mode 100644
index 0000000..adf71a4
--- /dev/null
+++ b/website/src/app/api/otp/verify/route.ts
@@ -0,0 +1,67 @@
+import { createClient } from "@supabase/supabase-js";
+import { OTP, otpEnabled, normalizePhone, hashCode, verifyDecision, signToken, type Channel } from "@/lib/otp";
+
+const fail = (status: number, code: string, error: string, extra: Record<string, unknown> = {}) =>
+  Response.json({ error, code, ...extra }, { status });
+
+const MESSAGES = {
+  OTP_WRONG: "That code isn't right.",
+  OTP_EXPIRED: "That code has expired. Please ask for a new one.",
+  OTP_TOO_MANY_ATTEMPTS: "Too many tries. Please ask for a new code.",
+} as const;
+
+export async function POST(request: Request) {
+  if (!otpEnabled()) return fail(404, "OTP_DISABLED", "Phone verification is turned off.");
+
+  const body = await request.json().catch(() => null);
+  const phoneCode = typeof body?.phoneCode === "string" ? body.phoneCode : "+91";
+  const phone = normalizePhone(phoneCode, typeof body?.phone === "string" ? body.phone : "");
+  const code = typeof body?.code === "string" ? body.code.trim() : "";
+  if (!phone) return fail(400, "INVALID_PHONE", "Please enter a valid mobile number.");
+
+  const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
+  const key = process.env.SUPABASE_SERVICE_ROLE_KEY;
+  const secret = process.env.OTP_TOKEN_SECRET;
+  if (!url || !key || !secret) return fail(503, "SERVER_ERROR", "Phone verification is not configured.");
+  const supabase = createClient(url, key);
+  const codeHash = hashCode(phone, code, secret);
+
+  // Each guess claims an attempt with a compare-and-set on `attempts`, so parallel guesses
+  // can't exceed the limit; a guess that loses the race is re-read and re-checked.
+  for (let round = 0; round < 3; round++) {
+    const now = Date.now();
+    const { data: row, error } = await supabase
+      .from("phone_verifications")
+      .select("id, channel, code_hash, attempts, consumed_at, created_at")
+      .eq("phone", phone)
+      .order("created_at", { ascending: false })
+      .limit(1)
+      .maybeSingle();
+    if (error) return fail(500, "SERVER_ERROR", "Could not check the code. Please try again.");
+
+    const decision = verifyDecision(
+      row && { codeHash: row.code_hash, createdAt: Date.parse(row.created_at), attempts: row.attempts, consumed: !!row.consumed_at },
+      codeHash,
+      now,
+    );
+    if (!decision.ok && !decision.wrongGuess) return fail(decision.code === "OTP_EXPIRED" ? 400 : 429, decision.code, MESSAGES[decision.code]);
+
+    const { data: claimed, error: claimError } = await supabase
+      .from("phone_verifications")
+      .update(decision.ok ? { attempts: row!.attempts + 1, consumed_at: new Date(now).toISOString() } : { attempts: row!.attempts + 1 })
+      .eq("id", row!.id)
+      .eq("attempts", row!.attempts)
+      .is("consumed_at", null)
+      .select("id");
+    if (claimError) return fail(500, "SERVER_ERROR", "Could not check the code. Please try again.");
+    if (!claimed.length) continue;
+
+    if (decision.ok) {
+      return Response.json({ token: signToken(phone, row!.channel as Channel, now, secret), expiresIn: OTP.tokenTtlSec });
+    }
+    return decision.code === "OTP_WRONG"
+      ? fail(400, "OTP_WRONG", MESSAGES.OTP_WRONG, { attemptsLeft: decision.attemptsLeft })
+      : fail(429, "OTP_TOO_MANY_ATTEMPTS", MESSAGES.OTP_TOO_MANY_ATTEMPTS);
+  }
+  return fail(429, "OTP_TOO_MANY_ATTEMPTS", MESSAGES.OTP_TOO_MANY_ATTEMPTS);
+}
