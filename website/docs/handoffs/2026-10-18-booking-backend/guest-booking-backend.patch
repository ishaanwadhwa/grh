diff --git b/website/supabase/migrations/014_reservation_contact_and_verification.sql b/website/supabase/migrations/014_reservation_contact_and_verification.sql
new file mode 100644
index 0000000..9c46e69
--- /dev/null
+++ b/website/supabase/migrations/014_reservation_contact_and_verification.sql
@@ -0,0 +1,154 @@
+-- Website bookings: email is optional (a phone OR an email is required) and phone verification is
+-- recorded. The new function is server-only (service role), so the API's OTP and validation checks
+-- can't be skipped with the public anon key.
+--
+-- Rollout without downtime: this adds the new function next to the old one. Deploy the code that
+-- calls it, then apply 017, which drops the old anon-callable function.
+-- p_phone_verified has no default on purpose: an 11-argument call can only match the old function.
+ALTER TABLE public.reservations ADD COLUMN IF NOT EXISTS phone_verified BOOLEAN;
+COMMENT ON COLUMN public.reservations.phone_verified IS
+  'TRUE: code verified. FALSE: OTP was on but the guest booked without a code (staff confirm). NULL: not checked.';
+
+CREATE OR REPLACE FUNCTION public.create_restaurant_reservation(
+  p_restaurant_slug TEXT,
+  p_service_id UUID,
+  p_service_date DATE,
+  p_slot_time TIME,
+  p_party_size INTEGER,
+  p_guest_name TEXT,
+  p_guest_email TEXT,
+  p_phone_verified BOOLEAN,
+  p_guest_phone TEXT DEFAULT '',
+  p_guest_phone_code TEXT DEFAULT '+91',
+  p_is_whatsapp BOOLEAN DEFAULT FALSE,
+  p_special_requests TEXT DEFAULT NULL
+)
+RETURNS UUID
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path = public
+AS $$
+DECLARE
+  v_restaurant RECORD;
+  v_service RECORD;
+  v_open TIME;
+  v_close TIME;
+  v_override RECORD;
+  v_slot_offset INTEGER;
+  v_open_minute INTEGER;
+  v_close_minute INTEGER;
+  v_slot_minute INTEGER;
+  v_start TIMESTAMPTZ;
+  v_end TIMESTAMPTZ;
+  v_table_id UUID;
+  v_reservation_id UUID;
+  v_duration INTEGER;
+BEGIN
+  IF NULLIF(BTRIM(p_guest_name), '') IS NULL
+     OR (NULLIF(BTRIM(p_guest_email), '') IS NULL AND NULLIF(BTRIM(p_guest_phone), '') IS NULL)
+     OR p_party_size IS NULL OR p_party_size < 1 OR p_party_size > 50
+     OR p_slot_time IS NULL OR p_service_date IS NULL THEN
+    RAISE EXCEPTION USING MESSAGE = 'INVALID_RESERVATION', ERRCODE = '22023';
+  END IF;
+
+  SELECT r.id, r.timezone INTO v_restaurant
+    FROM public.restaurants r
+    WHERE r.slug = p_restaurant_slug AND r.is_active = TRUE;
+  IF v_restaurant.id IS NULL THEN
+    RAISE EXCEPTION USING MESSAGE = 'RESTAURANT_NOT_FOUND', ERRCODE = 'P0002';
+  END IF;
+
+  IF p_service_date < (NOW() AT TIME ZONE v_restaurant.timezone)::DATE THEN
+    RAISE EXCEPTION USING MESSAGE = 'SLOT_UNAVAILABLE', ERRCODE = 'P0001';
+  END IF;
+
+  SELECT s.* INTO v_service
+    FROM public.restaurant_services s
+    WHERE s.id = p_service_id AND s.restaurant_id = v_restaurant.id AND s.is_active = TRUE;
+  IF v_service.id IS NULL OR p_party_size NOT BETWEEN v_service.min_party_size AND v_service.max_party_size THEN
+    RAISE EXCEPTION USING MESSAGE = 'SLOT_UNAVAILABLE', ERRCODE = 'P0001';
+  END IF;
+
+  SELECT o.is_closed, o.opens_at, o.closes_at INTO v_override
+    FROM public.restaurant_service_date_overrides o
+    WHERE o.service_id = v_service.id AND o.service_date = p_service_date;
+  IF FOUND AND v_override.is_closed THEN
+    RAISE EXCEPTION USING MESSAGE = 'SLOT_UNAVAILABLE', ERRCODE = 'P0001';
+  END IF;
+  IF FOUND AND v_override.opens_at IS NOT NULL THEN
+    v_open := v_override.opens_at;
+    v_close := v_override.closes_at;
+  ELSE
+    SELECT h.opens_at, h.closes_at INTO v_open, v_close
+      FROM public.restaurant_service_hours h
+      WHERE h.service_id = v_service.id
+        AND h.day_of_week = EXTRACT(DOW FROM p_service_date)::SMALLINT;
+  END IF;
+
+  IF v_open IS NULL OR v_close IS NULL OR v_open = v_close THEN
+    RAISE EXCEPTION USING MESSAGE = 'SLOT_UNAVAILABLE', ERRCODE = 'P0001';
+  END IF;
+
+  v_open_minute := EXTRACT(HOUR FROM v_open)::INTEGER * 60 + EXTRACT(MINUTE FROM v_open)::INTEGER;
+  v_close_minute := EXTRACT(HOUR FROM v_close)::INTEGER * 60 + EXTRACT(MINUTE FROM v_close)::INTEGER;
+  IF v_close_minute <= v_open_minute THEN
+    v_close_minute := v_close_minute + 1440;
+  END IF;
+  v_slot_minute := EXTRACT(HOUR FROM p_slot_time)::INTEGER * 60 + EXTRACT(MINUTE FROM p_slot_time)::INTEGER;
+
+  IF v_slot_minute < v_open_minute OR v_slot_minute >= 1440 THEN
+    RAISE EXCEPTION USING MESSAGE = 'SLOT_UNAVAILABLE', ERRCODE = 'P0001';
+  END IF;
+
+  v_slot_offset := v_slot_minute - v_open_minute;
+  IF MOD(v_slot_offset, v_service.slot_interval_minutes) <> 0 THEN
+    RAISE EXCEPTION USING MESSAGE = 'SLOT_UNAVAILABLE', ERRCODE = 'P0001';
+  END IF;
+
+  v_duration := v_service.seating_duration_minutes + v_service.buffer_minutes;
+  IF v_slot_minute + v_duration > v_close_minute THEN
+    RAISE EXCEPTION USING MESSAGE = 'SLOT_UNAVAILABLE', ERRCODE = 'P0001';
+  END IF;
+
+  v_start := ((p_service_date + p_slot_time) AT TIME ZONE v_restaurant.timezone);
+  v_end := v_start + MAKE_INTERVAL(mins => v_duration);
+
+  SELECT t.id INTO v_table_id
+    FROM public.restaurant_floorplans f
+    JOIN public.restaurant_tables t ON t.floorplan_id = f.id
+    WHERE f.restaurant_id = v_restaurant.id AND f.is_active = TRUE
+      AND t.restaurant_id = v_restaurant.id AND t.is_active = TRUE
+      AND t.min_capacity <= p_party_size AND t.max_capacity >= p_party_size
+      AND NOT EXISTS (
+        SELECT 1 FROM public.reservation_table_assignments a
+        WHERE a.table_id = t.id AND a.released_at IS NULL
+          AND a.starts_at < v_end AND a.ends_at > v_start
+      )
+    ORDER BY (t.max_capacity - p_party_size), t.max_capacity, t.label
+    LIMIT 1
+    FOR UPDATE OF t SKIP LOCKED;
+
+  IF v_table_id IS NULL THEN
+    RAISE EXCEPTION USING MESSAGE = 'SLOT_UNAVAILABLE', ERRCODE = 'P0001';
+  END IF;
+
+  INSERT INTO public.reservations (
+    restaurant_id, service_id, guest_name, guest_email, guest_phone,
+    guest_phone_code, is_whatsapp, date, time, starts_at, ends_at,
+    party_size, status, source, special_requests, phone_verified
+  ) VALUES (
+    v_restaurant.id, v_service.id, BTRIM(p_guest_name), NULLIF(BTRIM(p_guest_email), ''),
+    COALESCE(p_guest_phone, ''), COALESCE(p_guest_phone_code, '+91'),
+    COALESCE(p_is_whatsapp, FALSE), p_service_date, TO_CHAR(p_slot_time, 'HH24:MI'),
+    v_start, v_end, p_party_size, 'confirmed', 'website', NULLIF(BTRIM(p_special_requests), ''), p_phone_verified
+  ) RETURNING id INTO v_reservation_id;
+
+  INSERT INTO public.reservation_table_assignments (reservation_id, table_id, starts_at, ends_at)
+  VALUES (v_reservation_id, v_table_id, v_start, v_end);
+
+  RETURN v_reservation_id;
+END;
+$$;
+
+REVOKE ALL ON FUNCTION public.create_restaurant_reservation(TEXT, UUID, DATE, TIME, INTEGER, TEXT, TEXT, BOOLEAN, TEXT, TEXT, BOOLEAN, TEXT) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.create_restaurant_reservation(TEXT, UUID, DATE, TIME, INTEGER, TEXT, TEXT, BOOLEAN, TEXT, TEXT, BOOLEAN, TEXT) TO service_role;
diff --git b/website/supabase/migrations/015_restaurant_menu_pdf.sql b/website/supabase/migrations/015_restaurant_menu_pdf.sql
new file mode 100644
index 0000000..21375df
--- /dev/null
+++ b/website/supabase/migrations/015_restaurant_menu_pdf.sql
@@ -0,0 +1,34 @@
+-- One menu PDF per restaurant, opened by "See menu" on the site. A structured menu can replace it later.
+ALTER TABLE public.restaurants ADD COLUMN IF NOT EXISTS menu_pdf_url TEXT;
+
+-- Public bucket: anyone can open a menu by its URL; only admins can add, replace or remove files.
+INSERT INTO storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
+VALUES ('restaurant-menus', 'restaurant-menus', TRUE, 10485760, ARRAY['application/pdf'])
+ON CONFLICT (id) DO UPDATE SET
+  public = TRUE,
+  file_size_limit = EXCLUDED.file_size_limit,
+  allowed_mime_types = EXCLUDED.allowed_mime_types;
+
+CREATE POLICY "Admins read restaurant menus" ON storage.objects
+  FOR SELECT TO authenticated USING (
+    bucket_id = 'restaurant-menus'
+    AND EXISTS (SELECT 1 FROM public.admin_profiles ap WHERE ap.id = auth.uid())
+  );
+CREATE POLICY "Admins upload restaurant menus" ON storage.objects
+  FOR INSERT TO authenticated WITH CHECK (
+    bucket_id = 'restaurant-menus'
+    AND EXISTS (SELECT 1 FROM public.admin_profiles ap WHERE ap.id = auth.uid())
+  );
+CREATE POLICY "Admins update restaurant menus" ON storage.objects
+  FOR UPDATE TO authenticated USING (
+    bucket_id = 'restaurant-menus'
+    AND EXISTS (SELECT 1 FROM public.admin_profiles ap WHERE ap.id = auth.uid())
+  ) WITH CHECK (
+    bucket_id = 'restaurant-menus'
+    AND EXISTS (SELECT 1 FROM public.admin_profiles ap WHERE ap.id = auth.uid())
+  );
+CREATE POLICY "Admins delete restaurant menus" ON storage.objects
+  FOR DELETE TO authenticated USING (
+    bucket_id = 'restaurant-menus'
+    AND EXISTS (SELECT 1 FROM public.admin_profiles ap WHERE ap.id = auth.uid())
+  );
diff --git b/website/supabase/migrations/016_phone_verifications.sql b/website/supabase/migrations/016_phone_verifications.sql
new file mode 100644
index 0000000..68df3c6
--- /dev/null
+++ b/website/supabase/migrations/016_phone_verifications.sql
@@ -0,0 +1,18 @@
+-- One row per booking code sent. Server-only: RLS on with no policies, so only the service role
+-- (the /api/otp routes) can read or write it. Rows older than a day are purged by /api/otp/send.
+CREATE TABLE IF NOT EXISTS public.phone_verifications (
+  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+  phone TEXT NOT NULL, -- country code + number, digits only
+  ip TEXT NOT NULL DEFAULT '',
+  channel TEXT NOT NULL CHECK (channel IN ('whatsapp', 'sms')),
+  code_hash TEXT NOT NULL,
+  attempts SMALLINT NOT NULL DEFAULT 0,
+  consumed_at TIMESTAMPTZ,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+
+CREATE INDEX IF NOT EXISTS phone_verifications_phone_created_idx ON public.phone_verifications (phone, created_at DESC);
+CREATE INDEX IF NOT EXISTS phone_verifications_ip_created_idx ON public.phone_verifications (ip, created_at DESC);
+
+ALTER TABLE public.phone_verifications ENABLE ROW LEVEL SECURITY;
+REVOKE ALL ON public.phone_verifications FROM anon, authenticated;
